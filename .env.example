# Aegis Core - Minecraft Server Connection & Configuration
# Place this in .env or configure in GitHub Codespaces Secrets / Settings

# Minecraft Server Host (127.0.0.1 for local Codespaces server, or remote IP/domain)
MINECRAFT_HOST=127.0.0.1

# Minecraft Server Game Port (TCP port for players and SLP ping, default: 25565)
MINECRAFT_PORT=25565

# Minecraft RCON Port (TCP port enabled in server.properties, default: 25575)
RCON_PORT=25575

# Minecraft RCON Password (Set to the value of rcon.password in your server.properties)
# IMPORTANT: Keep this secret in backend .env, never commit or expose to frontend
RCON_PASSWORD=

# Path to the Minecraft server directory in Codespaces (e.g. /workspaces/your-repo/server or ./minecraft)
# Used for reading real logs/latest.log, server.properties, and backups
MINECRAFT_SERVER_DIR=

# Optional: Command to start the server process if running locally in Codespaces
# Example: java -Xms2G -Xmx4G -jar server.jar nogui
START_COMMAND=
